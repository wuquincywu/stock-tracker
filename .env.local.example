# FinMind (https://finmindtrade.com) — optional but raises the free rate limit from 300 to 600 req/hr
FINMIND_TOKEN=

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mpkjudge@gmail.com

# Upstash Redis — auto-filled by the Vercel <-> Upstash Marketplace integration
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` to /api/cron/check-alerts
CRON_SECRET=
